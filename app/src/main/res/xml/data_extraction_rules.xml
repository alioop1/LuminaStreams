<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <cloud-backup>
        <!-- גיבוי העדפות משתמש (שפה, ערכת נושא, הגדרות וכו') -->
        <include domain="sharedpref" path="."/>

        <!-- אל תגבה את ה-DB של IPTV — גדול ומתחדש בכל טעינה -->
        <exclude domain="database" path="iptv_database"/>

        <!-- אל תגבה קבצי cache -->
        <exclude domain="file" path=".cache"/>
        <exclude domain="external" path=".cache"/>
    </cloud-backup>

    <device-transfer>
        <!-- העברה בין מכשירים — אותן הגדרות כמו cloud backup -->
        <include domain="sharedpref" path="."/>

        <exclude domain="database" path="iptv_database"/>
        <exclude domain="file" path=".cache"/>
        <exclude domain="external" path=".cache"/>
    </device-transfer>

</data-extraction-rules>
