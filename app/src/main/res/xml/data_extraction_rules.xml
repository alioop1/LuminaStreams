<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="."/>
        <include domain="file" path="."/>

        <exclude domain="database" path="lumina_iptv.db"/>
        <exclude domain="file" path="image_cache"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="file" path="."/>

        <exclude domain="database" path="lumina_iptv.db"/>
        <exclude domain="file" path="image_cache"/>
    </device-transfer>
</data-extraction-rules>