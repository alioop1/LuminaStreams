rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection: each user can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Device links (TV QR/code login). The TV is signed out while it waits,
    // so it may create and read its own pending code by id; listing all
    // codes is never allowed. Only the signed-in owner of an account can
    // complete a code with that account's email. Links are deleted after use.
    match /device_links/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['status', 'created'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.created is int;
      allow update: if resource.data.status == 'pending'
                    && request.auth != null
                    && request.resource.data.keys().hasOnly(['status', 'created', 'email', 'password', 'linked_at'])
                    && request.resource.data.status == 'completed'
                    && request.resource.data.email == request.auth.token.email;
      allow delete: if true;
    }
  }
}
